# Database
MONGODB_URI=mongodb://admin:password@localhost:27017/vignette_automation?authSource=admin

# Redis (for BullMQ)
REDIS_URL=redis://localhost:6379

# API
API_PORT=3001
API_KEY_SECRET=change-this-secret

# CAPTCHA Service
CAPTCHA_SERVICE=2captcha
CAPTCHA_API_KEY=your-2captcha-api-key

# Browser
BROWSER_HEADLESS=true
BROWSER_POOL_SIZE=3
BROWSER_TIMEOUT=30000

# BGToll
BGTOLL_LANGUAGE=en
BGTOLL_SESSION_TIMEOUT=840000

# Queue
QUEUE_CONCURRENCY=3
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY=5000

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
